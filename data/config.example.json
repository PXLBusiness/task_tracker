{
  "webhook_url": "https://your-n8n-instance.com/webhook/freshbooks-time",
  "clients_webhook_enabled": true,
  "clients_webhook_url": "https://your-n8n-instance.com/webhook/get-clients",
  "hotkey": "Alt+T",
  "mode_hotkeys": {
    "timer_mode": "Alt+1",
    "manual_mode": "Alt+2"
  },
  "recent_hotkeys": {
    "recent_1": "Ctrl+1",
    "recent_2": "Ctrl+2",
    "recent_3": "Ctrl+3",
    "recent_4": "Ctrl+4",
    "recent_5": "Ctrl+5"
  },
  "log_rules": {
    "min_minutes": 5,
    "round_after_minutes": 15,
    "round_to_minutes": 10
  },
  "idle_alerts_enabled": true,
  "idle_minutes": 15,
  "idle_sound": true,
  "window_width": 1000,
  "window_height": 1080,
  "use_logo": false,
  "logo_path": "",
  "project_title": "Task Tracker",
  "use_title": true,
  "milestones_enabled": true,
  "milestone_times": [60, 120, 180],
  "milestone_sound": true,
  "milestone_notification": true,
  "floating_widget_enabled": false,
  "recent_projects_limit": 5
}
